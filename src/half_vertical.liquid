    {% for item in rss.channel.item limit:1 %}
    {% assign thumb = item.enclosure.url | default: item.content.thumbnail.url %}
    <div class="flex flex--col flex--left h--full flex--top relative bg--gray-40 w--full">
      <img class="w--full aspect--4/3 lg:portrait:h--full image-dither image image--cover" src="{{ item.thumbnail.url }}">
      <div class="absolute news-title p--5 pt--10">
        <div class="text text--base font--bold text--gray-70 mb--1">
          {{ item.pubDate | date: "%s" | plus: tz_offset | date: "%H:%M" }}
        </div>
        <h2 class="text text--large lg:text--xlarge text--white">
          {{ item.title }}
        </h2>
      </div>
    </div>
    {% endfor %}

    <div class="w--full flex--col p--5 md:hidden lg:flex">
      {% for item in rss.channel.item offset:1 limit:10 %}
      <div class="flex value--xsmall gap--medium w--full h--full">
        <div class="flex flex--col flex--left gap--none stretch">
          <h2 class="w--full text text--base lg:text--base flex flex--center-y">
            <span class="value--xxsmall text--gray-30 w--14">
              {{ item.pubDate | date: "%s" | plus: tz_offset | date: "%H:%M" }}
            </span>
            <span class="w--full" data-clamp="1">
              {{ item.title }}
            </span>
          </h2>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="w--full flex--col p--4 flex lg:hidden">
      {% for item in rss.channel.item offset:1 limit:5 %}
      <div class="flex value--xsmall gap--medium w--full h--full">
        <div class="flex flex--col flex--left gap--none stretch">
          <h2 class="w--full text text--base lg:text--base flex flex--center-y">
            <span class="value--xxsmall text--gray-30 w--12">
              {{ item.pubDate | date: "%s" | plus: tz_offset | date: "%H:%M" }}
            </span>
            <span class="w--full" data-clamp="1">
              {{ item.title }}
            </span>
          </h2>
        </div>
      </div>
      {% endfor %}
    </div>
</div>