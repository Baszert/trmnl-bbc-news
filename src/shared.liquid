<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap" rel="stylesheet">

<style>
  /* Scoped to .bbc-news so the font and helpers don't leak into other plugins in a mashup */
  .bbc-news {
    font-family: "Google Sans Flex", sans-serif;
    font-style: normal;
  }

  .bbc-news .absolute {
    position: absolute;
  }

  .bbc-news .relative {
    position: relative;
  }

  .bbc-news .news-title {
    bottom: 0;
    width: 100%;
    background: linear-gradient(0deg,rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0) 100%);
  }
</style>

{% comment %} Used to show feed times in the user's own timezone {% endcomment %}
{% assign tz_offset = trmnl.user.utc_offset | default: 0 %}
